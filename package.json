{
  "name": "voicevox-task-tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "build:workflow-cli": "vite build --config workflow.vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "eval:golden": "tsc --project tsconfig.build.json && node dist/cli/tracker-run.js eval --fixtures tests/fixtures/golden --artifact artifacts/eval.json --report artifacts/run-reports/eval.json",
    "perf:profile": "tsc --project tsconfig.build.json && node dist/performance/run-profile.js",
    "tracker:run": "node dist/cli/tracker-run.js",
    "typecheck": "tsc --project tsconfig.json && tsc --project web/tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@openai/codex": "0.145.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.1.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "@octokit/graphql": "^9.0.3",
    "ajv": "^8.20.0",
    "graphql": "^17.0.2",
    "mdast-util-from-markdown": "^2.0.3",
    "preact": "^10.29.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
