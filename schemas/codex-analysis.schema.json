{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voicevox.github.io/voicevox_task_tracker/schemas/codex-element-output.schema.json",
  "title": "VOICEVOX Task Tracker Codex Element Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "item"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "6"
    },
    "item": {
      "$ref": "#/$defs/item"
    },
    "status": {
      "$ref": "#/$defs/statusResult"
    },
    "waitingOn": {
      "$ref": "#/$defs/waitingOnResult"
    },
    "nextAction": {
      "$ref": "#/$defs/nextActionResult"
    },
    "relations": {
      "$ref": "#/$defs/relationsResult"
    },
    "progress": {
      "$ref": "#/$defs/progressResult"
    },
    "importance": {
      "$ref": "#/$defs/importanceResult"
    },
    "deadline": {
      "$ref": "#/$defs/deadlineResult"
    },
    "notification": {
      "$ref": "#/$defs/notificationResult"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "url"],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
        "required": ["sourceId", "summary", "supports"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "supports": {
          "type": "string",
          "enum": ["element", "self_commitment"]
        }
      }
    },
    "resultBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence", "confidence", "uncertainties"],
      "properties": {
        "value": {},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting_for_assessment",
        "waiting_for_owner",
        "waiting_for_decision",
        "waiting_for_review",
        "waiting_for_revision",
        "waiting_for_reply",
        "waiting_for_work",
        "waiting_for_unblock",
        "waiting_for_automation",
        "waiting_for_merge",
        "in_progress",
        "unknown",
        "terminal_merged",
        "terminal_completed",
        "terminal_not_planned"
      ]
    },
    "waitingOnCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidateId", "role", "reasonSummary", "sourceIds", "confidence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["user", "team", "role", "item", "automation", "unknown"]
        },
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^\\S+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "author",
            "maintainer",
            "reviewer",
            "assignee",
            "respondent",
            "dependency",
            "merge_decider",
            "ci",
            "unknown"
          ]
        },
        "reasonSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "relationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "verdict", "reasonSummary", "sourceIds", "confidence"],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "current_is_blocked_by_target",
            "current_blocks_target",
            "current_implements_target",
            "target_is_subtask_of_current",
            "current_is_subtask_of_target",
            "duplicates",
            "related",
            "none"
          ]
        },
        "reasonSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latestMeaningfulSourceId", "reasonSummary", "confidence"],
      "properties": {
        "latestMeaningfulSourceId": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "reasonSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["significantFeature", "futureRisk", "rationale"],
      "properties": {
        "significantFeature": {
          "type": "boolean"
        },
        "futureRisk": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "rationale"],
      "properties": {
        "date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "reasonCode", "reasonSummary"],
      "properties": {
        "recommended": {
          "type": "boolean"
        },
        "reasonCode": {
          "type": "string",
          "enum": [
            "none",
            "assessment_overdue",
            "owner_overdue",
            "decision_overdue",
            "review_overdue",
            "revision_overdue",
            "reply_overdue",
            "owner_unknown",
            "blocker_overdue",
            "newly_unblocked",
            "dependency_cycle",
            "responsibility_changed",
            "merge_overdue",
            "automation_stuck"
          ]
        },
        "reasonSummary": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "statusResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/status"
            }
          }
        }
      ]
    },
    "waitingOnResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/waitingOnCandidate"
              }
            }
          }
        }
      ]
    },
    "nextActionResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      ]
    },
    "relationsResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/relationCandidate"
              }
            }
          }
        }
      ]
    },
    "progressResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/progress"
            }
          }
        }
      ]
    },
    "importanceResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/importance"
            }
          }
        }
      ]
    },
    "deadlineResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/deadline"
            }
          }
        }
      ]
    },
    "notificationResult": {
      "allOf": [
        {
          "$ref": "#/$defs/resultBase"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/notification"
            }
          }
        }
      ]
    }
  }
}
