{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voicevox.github.io/voicevox_task_tracker/schemas/snapshot.schema.json",
  "title": "VOICEVOX Task Tracker Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "trackingStartAt",
    "ai",
    "collection",
    "repositories",
    "items",
    "externalReferences",
    "relations",
    "run"
  ],
  "properties": {
    "schemaVersion": {
      "const": "6"
    },
    "generatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "trackingStartAt": {
      "$ref": "#/$defs/trackingStartAt"
    },
    "ai": {
      "$ref": "#/$defs/ai"
    },
    "collection": {
      "$ref": "#/$defs/collection"
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "externalReferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalReference"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "run": {
      "$ref": "#/$defs/run"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S+$"
    },
    "shortString": {
      "type": "string",
      "maxLength": 1000
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "trackingStartAt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "not_fixed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "source"],
          "properties": {
            "status": {
              "const": "fixed"
            },
            "value": {
              "$ref": "#/$defs/dateTime"
            },
            "source": {
              "enum": ["configuration", "first_complete_run"]
            }
          }
        }
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trackedItemAiAnalysis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "cacheKey"],
          "properties": {
            "status": {
              "const": "used"
            },
            "cacheKey": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "enum": [
                "failed",
                "deferred",
                "not_required",
                "disabled",
                "not_recorded"
              ]
            }
          }
        }
      ]
    },
    "trackedItemInputEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "url"],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/identifier"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^https://github\\.com/"
        }
      }
    },
    "ai": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "available", "degraded"],
          "properties": {
            "enabled": {
              "const": false
            },
            "available": {
              "const": false
            },
            "degraded": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "available", "degraded"],
          "properties": {
            "enabled": {
              "const": true
            },
            "available": {
              "const": true
            },
            "degraded": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "available", "degraded"],
          "properties": {
            "enabled": {
              "const": true
            },
            "available": {
              "const": false
            },
            "degraded": {
              "const": true
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositories"],
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collectionRepository"
          }
        }
      }
    },
    "collectionRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "successfulAt", "items"],
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/identifier"
        },
        "successfulAt": {
          "$ref": "#/$defs/dateTime"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collectionItem"
          }
        }
      }
    },
    "collectionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "nodeId",
        "repositoryId",
        "itemFingerprint",
        "aiAnalysisFingerprint",
        "analysisRulesFingerprint",
        "deterministicRulesVersion",
        "observedAt",
        "state",
        "terminalAt"
      ],
      "properties": {
        "freshness": {
          "const": "fresh"
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "repositoryId": {
          "$ref": "#/$defs/identifier"
        },
        "itemFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "aiAnalysisFingerprint": {
          "$ref": "#/$defs/aiAnalysisFingerprint"
        },
        "analysisRulesFingerprint": {
          "$ref": "#/$defs/analysisRulesFingerprint"
        },
        "deterministicRulesVersion": {
          "$ref": "#/$defs/deterministicRulesVersion"
        },
        "observedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "state": {
          "enum": ["open", "closed"]
        },
        "terminalAt": {
          "oneOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "open"
              }
            },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "terminalAt": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "terminalAt": {
                "$ref": "#/$defs/dateTime"
              }
            }
          }
        }
      ]
    },
    "aiAnalysisFingerprint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fingerprint"],
          "properties": {
            "status": {
              "const": "available"
            },
            "fingerprint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceHash",
                "inputHash",
                "graphNeighborhoodHash",
                "identityHash"
              ],
              "properties": {
                "sourceHash": {
                  "$ref": "#/$defs/fingerprint"
                },
                "inputHash": {
                  "$ref": "#/$defs/fingerprint"
                },
                "graphNeighborhoodHash": {
                  "$ref": "#/$defs/fingerprint"
                },
                "identityHash": {
                  "$ref": "#/$defs/fingerprint"
                }
              }
            }
          }
        }
      ]
    },
    "analysisRulesFingerprint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fingerprint"],
          "properties": {
            "status": {
              "const": "available"
            },
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        }
      ]
    },
    "deterministicRulesVersion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "version"],
          "properties": {
            "status": {
              "const": "available"
            },
            "version": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "supports", "summary"],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/identifier"
        },
        "supports": {
          "enum": [
            "status",
            "waiting_on",
            "relation",
            "progress",
            "notification",
            "uncertainty"
          ]
        },
        "summary": {
          "$ref": "#/$defs/shortString"
        }
      }
    },
    "accountActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodeId", "login"],
      "properties": {
        "type": {
          "enum": ["human", "bot"]
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "actor": {
      "oneOf": [
        {
          "$ref": "#/$defs/accountActor"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": {
              "const": "system"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    },
    "itemAuthor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "actor"],
          "properties": {
            "status": {
              "const": "identified"
            },
            "actor": {
              "$ref": "#/$defs/accountActor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "const": "deleted_account"
            }
          }
        }
      ]
    },
    "latestEventActor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "actor"],
          "properties": {
            "status": {
              "const": "present"
            },
            "actor": {
              "$ref": "#/$defs/actor"
            }
          }
        }
      ]
    },
    "waitingOn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidateId",
        "role",
        "reasonSummary",
        "sourceIds",
        "confidence"
      ],
      "properties": {
        "kind": {
          "enum": ["user", "team", "role", "item", "automation", "unknown"]
        },
        "candidateId": {
          "$ref": "#/$defs/identifier"
        },
        "role": {
          "enum": [
            "author",
            "maintainer",
            "reviewer",
            "assignee",
            "dependency",
            "merge_decider",
            "ci",
            "unknown"
          ]
        },
        "reasonSummary": {
          "$ref": "#/$defs/shortString"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "primaryWaitingOn": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "selectionReason"],
          "properties": {
            "index": {
              "const": 0
            },
            "selectionReason": {
              "$ref": "#/$defs/shortString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "selectionReason"],
          "properties": {
            "index": {
              "const": "not_applicable"
            },
            "selectionReason": {
              "$ref": "#/$defs/shortString"
            }
          }
        }
      ]
    },
    "externalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nodeId",
        "repositoryFullName",
        "number",
        "url",
        "title",
        "state",
        "recursiveTracking",
        "directNotification"
      ],
      "properties": {
        "kind": {
          "const": "external_reference"
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "repositoryFullName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 513
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^https://github\\.com/"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "state": {
          "enum": ["open", "closed", "merged"]
        },
        "recursiveTracking": {
          "const": "not_allowed"
        },
        "directNotification": {
          "const": "not_eligible"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "name",
        "visibility",
        "archived",
        "disabled",
        "observedAt",
        "freshness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "const": "public"
        },
        "archived": {
          "const": false
        },
        "disabled": {
          "const": false
        },
        "observedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "freshness": {
          "enum": ["fresh", "stale"]
        },
        "failedAt": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["freshness"],
            "properties": {
              "freshness": {
                "const": "stale"
              }
            }
          },
          "then": {
            "properties": {
              "failedAt": {
                "$ref": "#/$defs/dateTime"
              }
            },
            "required": ["failedAt"]
          },
          "else": {
            "not": {
              "required": ["failedAt"]
            }
          }
        }
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "number", "title", "state", "dueOn"],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "state": {
          "enum": ["open", "closed"]
        },
        "dueOn": {
          "anyOf": [
            {
              "$ref": "#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "importanceFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "points", "detail"],
      "properties": {
        "kind": {
          "enum": [
            "priorityLabel",
            "downstreamImpact",
            "milestoneDeadline",
            "significantFeature",
            "explicitDeadline",
            "futureRisk"
          ]
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "importance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "level", "factors"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "enum": ["low", "medium", "high"]
        },
        "factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/importanceFactor"
          }
        }
      }
    },
    "importanceAssessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "const": "not_available"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "significantFeature",
                "explicitDeadline",
                "futureRisk",
                "rationale"
              ],
              "properties": {
                "significantFeature": {
                  "type": "boolean"
                },
                "explicitDeadline": {
                  "type": "boolean"
                },
                "futureRisk": {
                  "type": "boolean"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "type",
        "repositoryId",
        "displayReference",
        "number",
        "url",
        "title",
        "milestone",
        "importance",
        "importanceAssessment",
        "author",
        "latestEventActor",
        "state",
        "notificationClass",
        "status",
        "waitingOn",
        "primaryWaitingOn",
        "nextAction",
        "createdAt",
        "githubUpdatedAt",
        "lastHumanActivityAt",
        "lastProgressAt",
        "statusSince",
        "ownerSince",
        "stallSince",
        "observedAt",
        "labels",
        "assignees",
        "reviewState",
        "checkState",
        "aiAnalysis",
        "inputEvents",
        "confidence",
        "evidence",
        "uncertainties",
        "severity",
        "severityContext"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": ["issue", "pull_request"]
        },
        "repositoryId": {
          "$ref": "#/$defs/identifier"
        },
        "displayReference": {
          "type": "string",
          "minLength": 4,
          "maxLength": 600,
          "pattern": "^.+/.+#[1-9][0-9]*$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^https://github\\.com/"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "milestone": {
          "anyOf": [
            {
              "$ref": "#/$defs/milestone"
            },
            {
              "type": "null"
            }
          ]
        },
        "importance": {
          "$ref": "#/$defs/importance"
        },
        "importanceAssessment": {
          "$ref": "#/$defs/importanceAssessment"
        },
        "author": {
          "$ref": "#/$defs/itemAuthor"
        },
        "latestEventActor": {
          "$ref": "#/$defs/latestEventActor"
        },
        "state": {
          "enum": ["open", "closed", "merged"]
        },
        "notificationClass": {
          "enum": ["standard", "automation_noise"]
        },
        "status": {
          "enum": [
            "new_untriaged",
            "needs_maintainer_decision",
            "waiting_for_review",
            "waiting_for_author",
            "waiting_for_assignee",
            "blocked",
            "waiting_for_automation",
            "ready_to_merge",
            "in_progress",
            "unknown",
            "terminal_merged",
            "terminal_completed",
            "terminal_not_planned"
          ]
        },
        "waitingOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waitingOn"
          }
        },
        "primaryWaitingOn": {
          "$ref": "#/$defs/primaryWaitingOn"
        },
        "nextAction": {
          "$ref": "#/$defs/shortString"
        },
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "githubUpdatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "lastHumanActivityAt": {
          "$ref": "#/$defs/dateTime"
        },
        "lastProgressAt": {
          "$ref": "#/$defs/dateTime"
        },
        "statusSince": {
          "$ref": "#/$defs/dateTime"
        },
        "ownerSince": {
          "$ref": "#/$defs/dateTime"
        },
        "stallSince": {
          "$ref": "#/$defs/dateTime"
        },
        "observedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "assignees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accountActor"
          }
        },
        "reviewState": {
          "enum": [
            "not_applicable",
            "not_requested",
            "requested",
            "changes_requested",
            "approved",
            "unknown"
          ]
        },
        "checkState": {
          "enum": [
            "not_applicable",
            "not_required",
            "pending",
            "passing",
            "failing",
            "conflict",
            "unknown"
          ]
        },
        "aiAnalysis": {
          "$ref": "#/$defs/trackedItemAiAnalysis"
        },
        "inputEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackedItemInputEvent"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shortString"
          }
        },
        "severity": {
          "enum": ["none", "watch", "urgent", "critical"]
        },
        "severityContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["waitClass", "decisionBasis"],
          "properties": {
            "waitClass": {
              "enum": [
                "maintainerTriage",
                "ownerUnknown",
                "reviewer",
                "authorAfterChangesRequested",
                "assigneeOrInProgress",
                "readyToMerge",
                "automation",
                "blockedParent",
                "notApplicable"
              ]
            },
            "decisionBasis": {
              "enum": ["deterministic", "ai_only"]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {
              "status": {
                "enum": ["terminal_merged", "terminal_completed", "terminal_not_planned"]
              }
            }
          },
          "then": {
            "properties": {
              "waitingOn": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "relationContradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "confidence"],
      "properties": {
        "verdict": {
          "enum": [
            "current_is_blocked_by_target",
            "current_blocks_target",
            "current_implements_target",
            "target_is_subtask_of_current",
            "current_is_subtask_of_target",
            "duplicates",
            "related",
            "none"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fromNodeId",
        "toNodeId",
        "type",
        "provenance",
        "confidence",
        "evidence",
        "contradictions",
        "active",
        "firstSeenAt",
        "lastConfirmedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "fromNodeId": {
          "$ref": "#/$defs/identifier"
        },
        "toNodeId": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": ["blocks", "parent_of", "implements", "related_to", "duplicates"]
        },
        "provenance": {
          "enum": [
            "native",
            "explicit_text",
            "closing_keyword",
            "checklist",
            "cross_reference",
            "ai_inference"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationContradiction"
          }
        },
        "active": {
          "type": "boolean"
        },
        "firstSeenAt": {
          "$ref": "#/$defs/dateTime"
        },
        "lastConfirmedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "removedAt": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["active"],
            "properties": {
              "active": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "removedAt": {
                "$ref": "#/$defs/dateTime"
              }
            },
            "required": ["removedAt"]
          },
          "else": {
            "not": {
              "required": ["removedAt"]
            }
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "complete"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": ["success", "fallback"]
        },
        "complete": {
          "const": true
        }
      }
    }
  }
}
